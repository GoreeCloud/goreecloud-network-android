    <string name="advanced_disable_client_routes">Disable received routes</string>
    <string name="advanced_disable_client_routes_desc">Stops this device from using private routes assigned by the management service. This can make approved resources unreachable.</string>
    <string name="advanced_disable_server_routes">Disable routing for other devices</string>
    <string name="advanced_disable_server_routes_desc">Stops this device from forwarding server routes assigned by the management service. Use only when this device should no longer act as a routing peer.</string>
    <string name="advanced_disable_dns">Disable managed DNS</string>
    <string name="advanced_disable_dns_desc">Stops GoreeCloud Network from applying DNS configuration to this device. Private GoreeCloud names and filtering may stop working.</string>
    <string name="advanced_disable_firewall">Disable client firewall enforcement</string>
    <string name="advanced_disable_firewall_desc">Turns off GoreeCloud Network client-side firewall enforcement on this device. This weakens a network protection boundary and should be used only for controlled troubleshooting.</string>
    <string name="advanced_disable_ipv6">Disable overlay IPv6</string>
    <string name="advanced_disable_ipv6_desc">Disables IPv6 overlay addressing on the GoreeCloud Network tunnel interface.</string>
    <string name="advanced_allow_ssh">Allow network SSH service</string>
    <string name="advanced_allow_ssh_desc">Allows the client’s network SSH capability. This does not replace host authentication, authorization, firewall policy, or GoreeCloud administrative-access requirements.</string>
    <string name="advanced_block_inbound">Block inbound network connections</string>
    <string name="advanced_block_inbound_desc">Blocks inbound connections to this device and its routed networks, overriding received access policies for inbound traffic.</string>

